        </dmn:outputEntry>
        <dmn:outputEntry id="rule_what_major_compare_answer_plan">
          <dmn:text>&quot;what_major_compare&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>Route Major/Specialization/AcademicProgram entity comparisons to the academic compare plan.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="rule_what_ops_major_spec_academic_attr">
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_qtype">
          <dmn:text>&quot;what&quot;</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_intent">
          <dmn:text>&quot;attributes&quot;, &quot;definition&quot;</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_topic">
          <dmn:text>&quot;major&quot;, &quot;program&quot;, &quot;career&quot;</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_subtopics">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_compare_mode">
          <dmn:text>false</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_time_compare">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_need_disambig">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_ops_major_spec_academic_attr_potential_type">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="rule_what_ops_major_spec_academic_attr_query_plan">
