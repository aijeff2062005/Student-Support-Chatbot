          <dmn:text>&quot;what_ops_major_spec_academic&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>what + attributes + major/program → normalize Major/Specialization/AcademicProgram to parent Major, then collect academic tree.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
