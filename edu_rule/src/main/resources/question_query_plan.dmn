      <dmn:rule id="rule_what_major_compare">
        <dmn:inputEntry id="rule_what_major_compare_qtype">
          <dmn:text>&quot;what&quot;</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_major_compare_intent">
          <dmn:text>&quot;attributes&quot;, &quot;definition&quot;</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_major_compare_topic">
          <dmn:text>&quot;major&quot;, &quot;program&quot;</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_major_compare_subtopics">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_major_compare_compare_mode">
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_major_compare_time_compare">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_major_compare_need_disambig">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="rule_what_major_compare_potential_type">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
