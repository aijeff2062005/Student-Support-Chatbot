        <dmn:outputEntry id="_9C232D7D-9129-41E0-85FB-5C981D350F79">
          <dmn:text>&quot;{user_pronoun} giúp {self_pronoun} điền nhanh một vài thông tin cần thiết nhé: func(check_missing_fields_user_profile), để việc tư vấn được chính xác và sát nhu cầu hơn.&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_62433883-11FB-4D8D-A94E-E129715BCD29">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_026DE295-0A2A-4B3D-A4D6-52C89E498880">
          <dmn:text>[{&quot;type&quot;: &quot;instruction&quot;, &quot;prompt&quot;: &quot;{self_pronoun} tìm thấy thông tin trường THPT khớp với thông tin {user_pronoun} cung cấp, {user_pronoun} xác nhận giúp {self_pronoun} nhé.&quot;}, {&quot;type&quot;: &quot;execute&quot;, &quot;func&quot;: &quot;confirm_school_address&quot;}]</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_6">
          <dmn:text>{&quot;target&quot;:&quot;Thu thập thông tin hồ sơ cá nhân còn thiếu và xác nhận trường THPT nếu cần, để tiếp tục tư vấn hoặc hỗ trợ đăng ký chính xác hơn.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng cung cấp thông tin hồ sơ còn thiếu như trường THPT, lớp, điểm, khu vực, năm tốt nghiệp hoặc ngành quan tâm.&quot;,&quot;Người dùng xác nhận hoặc chỉnh lại thông tin trường THPT mà hệ thống tìm thấy.&quot;,&quot;Người dùng đồng ý cho hỏi tiếp hoặc hỏi cần bổ sung những thông tin nào.&quot;],&quot;generic&quot;:[&quot;Người dùng vẫn hỏi lại deadline, quy trình, điều kiện xét tuyển, so sánh ngành hoặc nội dung tuyển sinh liên quan nhưng chưa bổ sung thông tin được yêu cầu.&quot;,&quot;Người dùng phản hồi mơ hồ, do dự hoặc chỉ cung cấp một phần rất ít thông tin.&quot;],&quot;not_follow&quot;:[&quot;Người dùng chuyển hẳn sang chủ đề không phục vụ việc bổ sung hồ sơ, tư vấn tuyển sinh hoặc đăng ký dự tuyển hiện tại.&quot;,&quot;Người dùng hỏi hoặc nói sang dịch vụ hay nội dung ngoài phạm vi tuyển sinh hiện tại.&quot;]},&quot;policy&quot;:{&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Giải thích nhẹ nhàng vì sao cần thêm thông tin hồ sơ còn thiếu để tư vấn sát hơn.&quot;,&quot;response_text_hint&quot;:&quot;Mình muốn hỏi thêm bạn một vài thông tin như func(ask_all_information) để phần tư vấn sát hơn và dễ đi tiếp hơn. Bạn chưa cần gửi hết ngay đâu, mình đi từng phần một cũng được nhé.&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Giữ cuộc trò chuyện tự nhiên khi người dùng đang làm lệch hướng hội thoại, nhưng vẫn khéo léo mở đường quay lại nội dung tuyển sinh.&quot;,&quot;response_text_hint&quot;:&quot;Mình vẫn đang hỗ trợ bạn bên phần tuyển sinh nè. Khi mình quay lại đúng luồng thì mình sẽ hỗ trợ bạn bổ sung thông tin và sắp xếp từng phần cho dễ theo dõi hơn nha.&quot;},{&quot;response_goal&quot;:&quot;Duy trì hội thoại thoải mái mà chưa tạo cảm giác bị hỏi thông tin, đồng thời khéo léo cho người dùng thấy việc bổ sung hồ sơ sẽ giúp tư vấn đúng hướng và sát thực tế hơn.&quot;,&quot;response_text_hint&quot;:&quot;Mỗi hồ sơ sẽ có vài điểm khác nhau nên đôi khi chỉ cần biết thêm một chút về tình trạng học hiện tại hay trường THPT thôi là mình đã có thể định hướng sát hơn cho bạn nhiều rồi. Còn bây giờ thì mình vẫn cứ trò chuyện thoải mái với bạn trước nha.&quot;},{&quot;response_goal&quot;:&quot;Nhẹ nhàng kéo cuộc trò chuyện quay lại phạm vi hỗ trợ tuyển sinh và chủ động hơn trong việc xin thêm thông tin cần thiết để tránh tư vấn lệch hướng hoặc thiếu chính xác.&quot;,&quot;response_text_hint&quot;:&quot;Để mình không tư vấn lệch mất trường hợp của bạn thì mình cần đối chiếu thêm vài thông tin cơ bản như tình trạng học hiện tại hoặc trường THPT của bạn nữa nè. Bạn chia sẻ ngắn gọn giúp mình nha, rồi mình sẽ hỗ trợ bạn sát hướng và dễ hiểu hơn nhiều.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
