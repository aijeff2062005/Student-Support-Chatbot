        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_5">
          <dmn:text>{&quot;target&quot;:&quot;Làm rõ người dùng đang nghiêng về hoặc muốn chốt ngành nào trong các ngành đang cân nhắc, để tiếp tục tư vấn và hỗ trợ đăng ký theo đúng hướng.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng chọn một ngành đang cân nhắc, xin so sánh thêm giữa các ngành hiện có hoặc nêu rõ ngành mình nghiêng về.&quot;,&quot;Người dùng chia sẻ thêm sở thích, điểm mạnh, kiểu học, kiểu làm việc hoặc mục tiêu nghề nghiệp để phân biệt giữa các ngành.&quot;,&quot;Người dùng chuyển sang chốt hoặc xin tư vấn một ngành khác nhưng vẫn còn trong hướng chọn ngành.&quot;],&quot;generic&quot;:[&quot;Người dùng phân vân, chưa biết chọn ngành nào, hoặc trả lời kiểu ngành nào cũng được.&quot;,&quot;Người dùng phản hồi quá chung chung, chưa đủ để nghiêng về một ngành cụ thể.&quot;],&quot;not_follow&quot;:[&quot;Người dùng chuyển sang chủ đề không còn phục vụ việc quyết định ngành học hiện tại.&quot;,&quot;Người dùng hỏi hoặc nói sang nội dung ngoài phạm vi tư vấn chọn ngành ở bước này.&quot;]},&quot;policy&quot;:{&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Bình thường hóa sự phân vân và mở các cách thu hẹp lựa chọn ngành.&quot;,&quot;response_text_hint&quot;:&quot;Phân vân ở bước này là rất bình thường nhé. Nếu bạn muốn, mình có thể cùng bạn gỡ từng chút một: nói rõ hơn về từng ngành, so sánh nhanh giữa vài lựa chọn, hoặc dựa vào sở thích và kiểu công việc bạn mong muốn để thu hẹp dễ hơn. Bạn thấy mình nên đi theo hướng nào trước?&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Ưu tiên nội dung người dùng đang quan tâm nhưng vẫn giữ mở hướng quay lại chuyện chọn ngành khi phù hợp.&quot;,&quot;response_text_hint&quot;:&quot;Được thôi, khi nào bạn muốn quay lại chuyện chọn ngành, mình vẫn có thể hỗ trợ bạn nhìn rõ hơn từng lựa chọn để dễ dàng đưa ra định hướng hơn nhé.&quot;},{&quot;response_goal&quot;:&quot;Giữ cuộc trò chuyện tự nhiên và thoải mái mà chưa tạo áp lực phải chọn ngành ngay, đồng thời gợi mở nhẹ việc hiểu bản thân để định hướng dễ hơn sau này.&quot;,&quot;response_text_hint&quot;:&quot;Nhiều bạn khi tìm ngành cũng cần thêm thời gian để hiểu bản thân hợp với điều gì hơn. Khi nào bạn muốn quay lại phần định hướng, mình có thể cùng bạn nhìn lại sở thích, kiểu học hoặc môi trường làm việc phù hợp để thu hẹp lựa chọn dễ hơn.&quot;},{&quot;response_goal&quot;:&quot;Soft redirect quay lại phạm vi hỗ trợ định hướng ngành học và tư vấn tuyển sinh.&quot;,&quot;response_text_hint&quot;:&quot;Hiện tại mình chỉ hỗ trợ chủ yếu các nội dung liên quan đến định hướng ngành học và tuyển sinh nha. Nếu bạn muốn, mình có thể giúp bạn phân tích các nhóm ngành phù hợp hoặc so sánh giữa những lựa chọn bạn đang cân nhắc để hỗ trợ đúng hướng hơn.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_06CE4FEA-6366-42BC-839C-93CA1F2F9E62">
          <dmn:text>&quot;5&quot;</dmn:text>
        </dmn:outputEntry>
