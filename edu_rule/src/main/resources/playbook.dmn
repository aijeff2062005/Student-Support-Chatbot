        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_14">
          <dmn:text>{&quot;target&quot;:&quot;Đưa ra các ngành được đề xuất và hướng người dùng chọn một ngành cụ thể hoặc nêu ngành họ muốn được tư vấn sâu hơn.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng chọn một ngành trong danh sách đề xuất hoặc hỏi sâu hơn về một ngành được gợi ý.&quot;,&quot;Người dùng xin so sánh giữa các ngành đề xuất để thu hẹp lựa chọn.&quot;,&quot;Người dùng nêu một ngành khác họ muốn chốt hoặc muốn được tư vấn kỹ hơn nhưng vẫn còn trong hướng chọn ngành.&quot;],&quot;generic&quot;:[&quot;Người dùng nói sẽ xem thêm, chưa chọn được hoặc phản hồi lửng với danh sách ngành được đề xuất.&quot;,&quot;Người dùng vẫn ở gần bước chọn ngành nhưng chưa đưa tín hiệu đủ rõ để thu hẹp lựa chọn.&quot;],&quot;not_follow&quot;:[&quot;Người dùng chuyển sang chủ đề không liên quan đến việc chọn hoặc làm rõ ngành quan tâm.&quot;,&quot;Người dùng hỏi hoặc nói sang nội dung ngoài phạm vi tư vấn chọn ngành ở bước này.&quot;]},&quot;policy&quot;:{&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Giảm áp lực phải chốt ngay và mở các hướng so sánh hoặc đổi ngành.&quot;,&quot;response_text_hint&quot;:&quot;Không cần chốt ngay đâu nhé. Nếu bạn muốn, mình có thể nói ngắn gọn hơn về từng ngành, so sánh nhanh giữa vài lựa chọn, hoặc đổi sang một ngành khác mà bạn đang nghĩ tới. Bạn muốn mình đi theo hướng nào trước?&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Theo mối quan tâm hiện tại trước rồi giữ nhịp để quay lại bước chọn ngành khi phù hợp.&quot;,&quot;response_text_hint&quot;:&quot;Khi nào bạn cần quay lại phần chọn ngành thì cứ nói với mình nhé, mình sẽ giúp bạn nhìn từng hướng theo cách dễ hiểu hơn để đỡ bị rối nha.&quot;},{&quot;response_goal&quot;:&quot;Khi người dùng chưa hợp tác hoặc liên tục né việc chọn ngành, tiếp tục giữ cuộc trò chuyện thoải mái nhưng bắt đầu gợi mở nhẹ để người dùng dần thu hẹp lựa chọn phù hợp với bản thân.&quot;,&quot;response_text_hint&quot;:&quot;Mình hiểu mà, chọn ngành thường dễ bị rối vì có nhiều hướng để nghĩ cùng lúc á. Thường chỉ cần biết mình thích kiểu công việc hoặc môi trường nào hơn một chút thôi là cũng dễ lọc ngành hơn nhiều rồi đó.&quot;},{&quot;response_goal&quot;:&quot;Khi người dùng tiếp tục né tránh hoặc không chịu chọn hướng cụ thể, chủ động hơn trong việc yêu cầu họ chọn tạm một ngành hoặc một nhóm ngành để bot có thể tiếp tục tư vấn sâu và đúng trọng tâm.&quot;,&quot;response_text_hint&quot;:&quot;Nếu mình cứ giữ quá nhiều hướng cùng lúc thì sẽ khó tư vấn sâu cho bạn lắm nè. Giờ bạn thử chọn tạm giúp mình một ngành hoặc một nhóm ngành bạn thấy đỡ xa với mình nhất trước nha, rồi mình sẽ tập trung phân tích kỹ hướng đó cho bạn dễ hình dung hơn.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
