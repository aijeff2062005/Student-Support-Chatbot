        <dmn:outputEntry id="_ECCD7EEB-A158-4255-94FC-D755EBD29BA4">
          <dmn:text>&quot;{self_pronoun} đã chuẩn bị sẵn form đăng ký dự tuyển, {user_pronoun} có thể bấm vào nút bên dưới để chủ động đăng ký. Ngoài ra, {user_pronoun} cũng có thể chia sẻ thêm một số thông tin cơ bản như: func(ask_all_information), để bên mình tư vấn sát với nhu cầu hơn.&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_27141FE0-66A9-4499-AA62-894F5CE86755">
          <dmn:text>[{&quot;name&quot;: &quot;Đăng ký dự tuyển&quot;, &quot;link&quot;: null, &quot;func&quot;: &quot;submit_enrollment_form&quot;}]</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_D4E276B4-E708-4476-939C-CBB821BCEC81">
          <dmn:text>[{&quot;type&quot;: &quot;instruction&quot;, &quot;prompt&quot;: &quot;{self_pronoun} tìm thấy thông tin trường THPT khớp với thông tin {user_pronoun} cung cấp, {user_pronoun} xác nhận giúp {self_pronoun} nhé.&quot;}, {&quot;type&quot;: &quot;execute&quot;, &quot;func&quot;: &quot;confirm_school_address&quot;}]</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_1">
          <dmn:text>{&quot;target&quot;:&quot;Khuyến khích người dùng bắt đầu đăng ký dự tuyển, đồng thời nhận thêm thông tin cơ bản và xác nhận trường THPT để hỗ trợ đăng ký đúng nhu cầu.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng đồng ý đăng ký, hỏi cách điền form, hỏi link hoặc nút đăng ký dự tuyển.&quot;,&quot;Người dùng cung cấp thêm thông tin cơ bản phục vụ tư vấn hoặc đăng ký dự tuyển.&quot;,&quot;Người dùng xác nhận hoặc chỉnh lại thông tin trường THPT mà hệ thống tìm thấy.&quot;,&quot;Người dùng quay sang chốt hoặc xin tư vấn ngành khác để chuẩn bị đăng ký đúng ngành.&quot;],&quot;generic&quot;:[&quot;Người dùng phản hồi lửng hoặc trì hoãn nhẹ như để xem thêm, để lát đăng ký, hoặc chưa cam kết hành động cụ thể.&quot;,&quot;Người dùng vẫn ở gần bước đăng ký nhưng chưa cung cấp thêm thông tin hay chưa quyết định thao tác tiếp theo.&quot;],&quot;not_follow&quot;:[&quot;Người dùng chuyển sang chủ đề không còn phục vụ việc đăng ký dự tuyển hoặc tư vấn tuyển sinh hiện tại.&quot;,&quot;Người dùng hỏi hoặc nói sang dịch vụ hay nội dung ngoài phạm vi tuyển sinh hiện tại.&quot;]},&quot;policy&quot;:{&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Giữ người dùng ở gần bước đăng ký nhưng giảm áp lực phải quyết định ngay.&quot;,&quot;response_text_hint&quot;:&quot;Mình hiểu đây là một bước khá quan trọng nên bạn chưa cần quyết định ngay đâu nhé. Nếu bạn muốn, mình có thể cùng bạn xem rõ hơn về ngành học, điều kiện xét tuyển hoặc chuẩn bị sẵn những thông tin cần thiết để khi đăng ký sẽ nhẹ nhàng hơn. Bạn muốn mình bắt đầu từ phần nào trước?&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Giữ cuộc trò chuyện tự nhiên khi người dùng chưa tập trung vào việc đăng ký, đồng thời vẫn giữ mở hướng quay lại hỗ trợ tuyển sinh khi phù hợp.&quot;,&quot;response_text_hint&quot;:&quot;Mình vẫn ở đây hỗ trợ bạn nha. Khi nào bạn muốn quay lại phần tuyển sinh hoặc đăng ký thì mình có thể đồng hành cùng bạn từng bước để dễ chuẩn bị hơn.&quot;},{&quot;response_goal&quot;:&quot;Tiếp tục duy trì hội thoại và bắt đầu gợi nhẹ về việc chuẩn bị thông tin cần thiết để quá trình đăng ký sau này thuận tiện hơn, nhưng chưa tạo cảm giác bị thúc ép.&quot;,&quot;response_text_hint&quot;:&quot;Thường chỉ cần chuẩn bị sẵn vài thông tin cơ bản như ngành đang quan tâm hoặc trường THPT là lúc làm hồ sơ sẽ đỡ rối hơn nhiều đó. Khi cần, mình có thể hỗ trợ bạn rà từng phần cho dễ hơn nha.&quot;},{&quot;response_goal&quot;:&quot;Nhẹ nhàng kéo cuộc trò chuyện quay lại phạm vi hỗ trợ tuyển sinh và chủ động hơn trong việc khuyến khích người dùng bắt đầu chuẩn bị đăng ký hoặc cung cấp thông tin cần thiết để hỗ trợ đúng nhu cầu.&quot;,&quot;response_text_hint&quot;:&quot;Để mình hỗ trợ bạn đúng hướng hơn trong phần tuyển sinh và đăng ký thì giờ mình cần biết thêm một chút thông tin cơ bản như ngành bạn đang quan tâm hoặc trường THPT hiện tại. Bạn chia sẻ ngắn gọn giúp mình nha để mình hỗ trợ sát nhu cầu của bạn hơn.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_EB17E122-E967-42CE-BF15-CA17E40359D4">
          <dmn:text>&quot;1&quot;</dmn:text>
        </dmn:outputEntry>
