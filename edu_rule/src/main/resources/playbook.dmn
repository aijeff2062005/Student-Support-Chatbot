        <dmn:outputEntry id="_C567E8FE-CE5E-43CF-AB0C-60CEE644D2E9">
          <dmn:text>&quot;Cho {self_pronoun} hỏi nhanh nhé, {user_pronoun} đang là học sinh hay phụ huynh đang tìm hiểu thông tin tuyển sinh thế ạ?&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_849EA19B-6E02-4364-A16F-97B9BE2BF041">
          <dmn:text>[{&quot;name&quot;: &quot;Phụ huynh&quot;, &quot;link&quot;: null}, {&quot;name&quot;: &quot;Học sinh&quot;, &quot;link&quot;: null}]</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_A5620EC0-51FA-4D94-B951-108FBDB728E5">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_11">
          <dmn:text>{&quot;target&quot;:&quot;Xác định người đang trao đổi là học sinh hay phụ huynh để chọn cách tư vấn tuyển sinh phù hợp.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng chọn rõ mình là học sinh hoặc phụ huynh.&quot;,&quot;Người dùng mô tả vai trò của mình theo cách tương đương như em là học sinh lớp 12 hoặc tôi là phụ huynh.&quot;,&quot;Người dùng hỏi thêm nhưng vẫn xoay quanh việc xác định vai trò người hỏi.&quot;],&quot;generic&quot;:[&quot;Người dùng trả lời mơ hồ như hỏi giúp, người nhà em, hoặc chưa nói rõ ai là người ra quyết định chính.&quot;,&quot;Người dùng phản hồi ngắn nhưng chưa đủ để xác định chắc vai trò.&quot;,&quot;Người dùng hỏi vặn lại mục đích như bạn hỏi để làm gì, hỏi chi vậy hoặc cần role để làm gì nhưng chưa kéo sang topic khác hẳn.&quot;],&quot;not_follow&quot;:[&quot;Người dùng bỏ qua hẳn bước xác định vai trò và chuyển sang chủ đề không liên quan.&quot;,&quot;Người dùng hỏi hoặc nói sang nội dung ngoài phạm vi scoping vai trò ở bước này.&quot;]},&quot;policy&quot;:{&quot;slot_name&quot;:&quot;role&quot;,&quot;required&quot;:false,&quot;defer_on&quot;:[&quot;generic&quot;,&quot;not_follow&quot;],&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Giải thích ngắn vì sao hỏi role rồi chuyển sang gợi mở topic người dùng quan tâm.&quot;,&quot;response_text_hint&quot;:&quot;Mình muốn hiểu rõ hơn điều bạn đang quan tâm để chia sẻ với bạn những thông tin thật sự hữu ích và phù hợp. Nếu bạn muốn, mình có thể cùng bạn tìm hiểu kỹ hơn về ngành học, học phí hoặc điều kiện xét tuyển. Bạn muốn bắt đầu từ phần nào trước?&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Soft redirect về các topic tuyển sinh gần nhất mà không hỏi lại role.&quot;,&quot;response_text_hint&quot;:&quot;Mình ưu tiên hỗ trợ đúng điều bạn đang quan tâm trước nhé. Nếu bạn muốn, mình có thể cùng bạn tìm hiểu kỹ hơn về ngành học, học phí hoặc điều kiện xét tuyển. Bạn muốn bắt đầu từ phần nào trước?&quot;},{&quot;response_goal&quot;:&quot;Soft redirect về các topic tuyển sinh gần nhất mà vẫn giữ hội thoại tự nhiên.&quot;,&quot;response_text_hint&quot;:&quot;Không sao nha. Nếu bạn cần thì mình vẫn có thể đồng hành cùng bạn trong chuyện chọn ngành, định hướng nghề nghiệp hoặc giải đáp các thông tin liên quan đến việc vào đại học. Bạn đang muốn quan tâm phần nào hơn nè?&quot;},{&quot;response_goal&quot;:&quot;Soft redirect mạnh hơn, thu hẹp phạm vi để kéo user quay lại flow tuyển sinh.&quot;,&quot;response_text_hint&quot;:&quot;Mình đang hỗ trợ chủ yếu các nội dung liên quan đến tuyển sinh và định hướng học tập tại GDU nha. Bạn có muốn mình gợi ý ngành phù hợp, xem thông tin chương trình học hoặc hỗ trợ chọn hướng phù hợp với mình không?&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
