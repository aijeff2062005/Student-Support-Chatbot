        <dmn:outputEntry id="_9F892559-55B2-4CDA-BEB0-AAB3C946E035">
          <dmn:text>[{&quot;type&quot;: &quot;instruction&quot;, &quot;prompt&quot;: &quot;Base on spam count is {spam_count}, let&apos;s answer follow guide: - 0–1: Soft redirect → remind scope + give 2–3 admissions options to choose from. - 2–3: Clear boundary → remind scope + ask ONE minimal info (role OR admission year OR interested major). - &gt;=4: Polite refusal → refuse off-topic + invite back + ask ONE minimal info to resume.&quot;}]</dmn:text>
        </dmn:outputEntry>
