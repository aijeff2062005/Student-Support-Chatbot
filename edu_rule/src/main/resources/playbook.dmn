        <dmn:outputEntry id="_A725FC08-FB07-4D61-B5E8-7C1EEDDE8ACD">
          <dmn:text>&quot;{self_pronoun} sẽ dùng các thông tin hiện có để nộp form đăng ký dự tuyển giúp {user_pronoun}. Trước khi {self_pronoun} nộp hồ sơ đăng ký dự tuyển, {user_pronoun} giúp {self_pronoun} xác nhận lại một số thông tin nhé. func(get_student_information_to_fill_form). Nếu thông tin đã đúng, {self_pronoun} sẽ tự động nộp form đăng ký dự tuyển cho ngành này để tiết kiệm thời gian.&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_88449732-6E5D-4568-A961-0450F468219D">
          <dmn:text>[{&quot;name&quot;: &quot;Xác nhận&quot;, &quot;link&quot;: null}]</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_62B873D4-DB8E-4A46-82B9-54DC761C450E">
          <dmn:text>[{&quot;type&quot;: &quot;instruction&quot;, &quot;prompt&quot;: &quot;- Summarize the customer information from JSON object into a clear confirmation message. - List each field as &apos;Label: Value&apos; in bullet type.&quot;}]</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_17">
          <dmn:text>{&quot;target&quot;: &quot;Xác nhận lại thông tin hồ sơ hiện có trước khi bot nộp form đăng ký dự tuyển cho người dùng.&quot;, &quot;behaviour&quot;: {&quot;follow&quot;: [&quot;Người dùng xác nhận thông tin đã đúng, bấm xác nhận hoặc đồng ý cho bot nộp form.&quot;, &quot;Người dùng chỉnh sửa, bổ sung hoặc hỏi lại chi tiết của các trường thông tin trong hồ sơ.&quot;, &quot;Người dùng hỏi cách xác nhận hoặc hỏi cần sửa chỗ nào trước khi nộp.&quot;], &quot;generic&quot;: [&quot;Người dùng phản hồi chung chung, trì hoãn nhẹ hoặc nói sẽ xem lại nhưng chưa xác nhận hay chỉnh thông tin cụ thể.&quot;, &quot;Người dùng vẫn còn ở bước xác nhận hồ sơ nhưng chưa đưa ra tín hiệu đủ rõ để nộp form.&quot;], &quot;not_follow&quot;: [&quot;Người dùng chuyển sang chủ đề không còn phục vụ việc xác nhận thông tin và nộp form đăng ký.&quot;, &quot;Người dùng hỏi hoặc nói sang nội dung ngoài phạm vi hoàn tất bước xác nhận hồ sơ hiện tại.&quot;]}, &quot;policy&quot;: {&quot;next_actions&quot;: {&quot;generic&quot;: {&quot;response_goal&quot;: &quot;Cho người dùng thêm không gian rà soát trước khi xác nhận.&quot;, &quot;response_text_hint&quot;: &quot;Bạn cứ xem lại thoải mái nhé, mình muốn bạn thật sự yên tâm rồi hẵng xác nhận. Nếu cần, mình có thể cùng bạn rà lại từng mục ngắn gọn, hoặc bạn nói luôn phần nào muốn chỉnh để mình hỗ trợ nhanh hơn.&quot;}, &quot;not_follow&quot;: [{&quot;response_goal&quot;: &quot;Tiếp nhận ý kiến ngoài lề để tạo sự thoải mái, nhưng khéo léo hẹn ngày quay lại xác nhận hồ sơ.&quot;, &quot;response_text_hint&quot;: &quot;Mình sẽ ưu tiên giải quyết các vấn đề bạn đang quan tâm trước để quá trình trao đổi được thoải mái nhất. Sau đó, chúng mình sẽ cùng dành ít phút rà soát lại thông tin hồ sơ cho thật chuẩn chỉnh trước khi chính thức nộp để bạn yên tâm nhất nha.&quot;}, {&quot;response_goal&quot;: &quot;Giữ hội thoại tự nhiên, không ép xác nhận ngay nhưng vẫn nhắc nhẹ về bước hoàn tất hồ sơ.&quot;, &quot;response_text_hint&quot;: &quot;Việc rà soát lại thông tin cuối cùng sẽ giúp bạn đảm bảo quyền lợi khi nộp form đăng ký dự tuyển. Khi nào đến lúc bạn sẵn sàng nộp hồ sơ, mình sẽ hỗ trợ rà lại nhanh các thông tin cần thiết để tránh sai sót.&quot;}, {&quot;response_goal&quot;: &quot;Soft redirect quay về phạm vi hỗ trợ tuyển sinh và hoàn tất đăng ký.&quot;, &quot;response_text_hint&quot;: &quot;Hiện tại mình hỗ trợ chủ yếu các nội dung liên quan đến đăng ký và thông tin tuyển sinh nha. Nếu cần, mình có thể giúp bạn kiểm tra hồ sơ, giải đáp thắc mắc hoặc hỗ trợ hoàn tất bước đăng ký luôn.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
