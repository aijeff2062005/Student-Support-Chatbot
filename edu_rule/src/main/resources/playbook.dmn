        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_12">
          <dmn:text>{&quot;target&quot;:&quot;Xác định mối quan tâm ưu tiên đầu cuộc trò chuyện như ngành học, điều kiện xét tuyển hoặc học phí, và nếu có thể thì làm rõ thêm khối ngành người dùng đang nghiêng về.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng chọn một trong các hướng như ngành học, điều kiện xét tuyển hoặc học phí.&quot;,&quot;Người dùng hỏi tiếp trong đúng một hướng quan tâm đó hoặc nêu luôn khối ngành, ngành học mình đang quan tâm.&quot;,&quot;Người dùng mô tả nhu cầu tư vấn theo cách giúp thu hẹp ưu tiên đầu funnel.&quot;],&quot;generic&quot;:[&quot;Người dùng nói cái nào cũng muốn biết, xem thêm đã hoặc chưa ưu tiên được hướng nào.&quot;,&quot;Người dùng vẫn còn gần bước scoping nhu cầu nhưng phản hồi quá rộng hoặc quá do dự.&quot;],&quot;not_follow&quot;:[&quot;Người dùng chuyển sang câu chuyện không phục vụ việc xác định nhu cầu tư vấn ban đầu.&quot;,&quot;Người dùng hỏi hoặc nói sang nội dung ngoài phạm vi định hướng mối quan tâm ưu tiên ở bước này.&quot;]},&quot;policy&quot;:{&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Giúp người dùng dễ bắt đầu bằng cách chia nhỏ các topic đầu funnel.&quot;,&quot;response_text_hint&quot;:&quot;Không sao nhé, nhiều bạn lúc đầu cũng muốn tìm hiểu nhiều thứ cùng lúc. Nếu mình đi từng phần một sẽ dễ theo dõi hơn. Mình có thể bắt đầu từ ngành học, học phí hoặc điều kiện xét tuyển, rồi mình mở tiếp những phần còn lại sau. Bạn muốn bắt đầu từ đâu trước?&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Ưu tiên nội dung người dùng đang quan tâm nhưng vẫn giữ mở hướng quay lại xác định nhu cầu tư vấn ban đầu.&quot;,&quot;response_text_hint&quot;:&quot;Khi nào bạn muốn tiếp tục được tư vấn phần tuyển sinh , mình vẫn có thể cùng bạn xác định nên ưu tiên tìm hiểu về ngành học, học phí hay điều kiện xét tuyển trước để dễ theo dõi hơn.&quot;},{&quot;response_goal&quot;:&quot;Giữ hội thoại tự nhiên, không yêu cầu xác định ưu tiên ngay nhưng vẫn gợi mở việc làm rõ nhu cầu để tư vấn đúng hướng hơn.&quot;,&quot;response_text_hint&quot;:&quot;Mình biết mỗi bạn khi tìm hiểu đại học sẽ thường quan tâm nhiều hơn đến một phần khác nhau. Khi nào bạn muốn đi sâu hơn vào chuyện tuyển sinh, mình có thể hỗ trợ bạn xác định phần nên ưu tiên trước để việc tìm hiểu rõ ràng và phù hợp hơn.&quot;},{&quot;response_goal&quot;:&quot;Soft redirect quay lại phạm vi hỗ trợ tuyển sinh và định hướng nhu cầu tư vấn phù hợp.&quot;,&quot;response_text_hint&quot;:&quot;Hiện tại mình hỗ trợ chủ yếu các nội dung liên quan đến tuyển sinh và định hướng chọn trường/ngành nha. Nếu cần, mình có thể đồng hành cùng bạn xác định nên bắt đầu từ ngành học, học phí hay điều kiện xét tuyển để hỗ trợ đúng phần bạn đang cần.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_D590D3FE-B216-4EC1-A42B-44EC109AF674">
          <dmn:text>&quot;12&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_2F6E64D4-BACE-4D40-8077-13747B7E0555">
          <dmn:text>1</dmn:text>
        </dmn:outputEntry>
