        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_7">
          <dmn:text>{&quot;target&quot;:&quot;Thu thập các tín hiệu cá nhân hóa như sở thích, điểm mạnh, kiểu tư duy và nghề nghiệp mong muốn để tư vấn ngành học phù hợp.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng chia sẻ sở thích, tính cách, điểm mạnh, môn học yêu thích hoặc kiểu công việc mong muốn.&quot;,&quot;Người dùng nêu định hướng nghề nghiệp, broad interest hoặc lĩnh vực mình muốn theo đuổi.&quot;,&quot;Người dùng hỏi ngược theo hướng nhờ tư vấn ngành dựa trên những đặc điểm cá nhân của mình.&quot;],&quot;generic&quot;:[&quot;Người dùng chưa biết rõ mình thích gì, thích nhiều thứ hoặc nói tùy tư vấn.&quot;,&quot;Người dùng đưa tín hiệu quá chung, chưa đủ để hình thành gợi ý ngành rõ ràng.&quot;],&quot;not_follow&quot;:[&quot;Người dùng chuyển sang chủ đề không giúp việc tư vấn ngành dựa trên sở thích và định hướng cá nhân.&quot;,&quot;Người dùng hỏi hoặc nói sang nội dung ngoài phạm vi bước thu thập tín hiệu cá nhân hóa này.&quot;]},&quot;policy&quot;:{&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Giảm áp lực khi người dùng chưa rõ bản thân hợp gì và chuyển sang hỏi nhẹ nhàng hơn.&quot;,&quot;response_text_hint&quot;:&quot;Nếu lúc này bạn chưa rõ mình hợp với điều gì thì cũng hoàn toàn bình thường nhé. Mình có thể đi từ những điều gần gũi hơn như môn bạn thích, kiểu công việc bạn thấy hứng thú, hoặc điều bạn không muốn theo. Mình hỏi bạn từng chút một cho nhẹ nhàng thôi.&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Ưu tiên nội dung người dùng đang quan tâm nhưng vẫn giữ mở hướng quay lại phần định hướng ngành phù hợp với bản thân.&quot;,&quot;response_text_hint&quot;:&quot;Khi cần quay lại chuyện chọn ngành, mình vẫn có thể cùng bạn nhìn lại sở thích, thế mạnh và định hướng cá nhân để tìm hướng phù hợp hơn với bạn nhé.&quot;},{&quot;response_goal&quot;:&quot;Giữ hội thoại tự nhiên, không yêu cầu chia sẻ ngay nhưng vẫn gợi mở việc hiểu bản thân để định hướng ngành rõ hơn.&quot;,&quot;response_text_hint&quot;:&quot;Việc hiểu rõ hơn về điểm mạnh, cách học hoặc môi trường làm việc bạn mong muốn sẽ giúp việc định hướng ngành dễ và sát hơn với bạn. Khi nào bạn muốn tìm hiểu sâu hơn, mình có thể đồng hành cùng bạn từng bước.&quot;},{&quot;response_goal&quot;:&quot;Soft redirect quay lại phạm vi hỗ trợ định hướng ngành và tư vấn tuyển sinh phù hợp với cá nhân người dùng.&quot;,&quot;response_text_hint&quot;:&quot;Bây giờ mình hỗ trợ chủ yếu các nội dung liên quan đến định hướng ngành học và tuyển sinh nha. Nếu cần, mình có thể giúp bạn phân tích sở thích, thế mạnh hoặc mục tiêu nghề nghiệp để tìm ngành phù hợp hơn với bạn đó ạ.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_9B99A635-99D7-4CEE-B0E8-D037F9B5D756">
          <dmn:text>&quot;7&quot;</dmn:text>
