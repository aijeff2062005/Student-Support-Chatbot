        </dmn:outputEntry>
        <dmn:outputEntry id="_TARGET_OUTPUT_ENTRY_18">
          <dmn:text>{&quot;target&quot;:&quot;Yêu cầu người dùng mở form đã điền sẵn, kiểm tra hoặc bổ sung thông tin còn thiếu, rồi hoàn tất thao tác nộp đơn đăng ký dự tuyển.&quot;,&quot;behaviour&quot;:{&quot;follow&quot;:[&quot;Người dùng nói sẽ xem lại form, hỏi cách mở form, hỏi cách nộp đơn hoặc xác nhận đã nộp.&quot;,&quot;Người dùng phản hồi về việc cần sửa, bổ sung hoặc kiểm tra thêm thông tin trong form.&quot;,&quot;Người dùng chọn CTA xem lại hoặc nộp ngay để hoàn tất bước đăng ký.&quot;],&quot;generic&quot;:[&quot;Người dùng phản hồi lửng, trì hoãn nhẹ hoặc nói sẽ làm sau nhưng vẫn còn quanh bước xem lại và nộp form.&quot;,&quot;Người dùng chưa thao tác ngay và cũng chưa nêu rõ cần hỗ trợ gì thêm để nộp đơn.&quot;],&quot;not_follow&quot;:[&quot;Người dùng chuyển sang chủ đề không còn phục vụ việc kiểm tra và nộp form đăng ký dự tuyển.&quot;,&quot;Người dùng hỏi hoặc nói sang nội dung ngoài phạm vi hoàn tất bước nộp form hiện tại.&quot;]},&quot;policy&quot;:{&quot;next_actions&quot;:{&quot;generic&quot;:{&quot;response_goal&quot;:&quot;Giảm áp lực thao tác và nhắc lại rằng có thể đi từng bước.&quot;,&quot;response_text_hint&quot;:&quot;Không cần vội đâu nhé. Khi thuận tiện, bạn chỉ cần mở form, xem lại thông tin và bổ sung phần còn thiếu là được. Nếu bạn muốn, mình có thể nhắc ngắn lại từng bước để bạn thao tác dễ hơn.&quot;},&quot;not_follow&quot;:[{&quot;response_goal&quot;:&quot;Ưu tiên nội dung người dùng đang quan tâm nhưng vẫn giữ mở hướng quay lại bước hoàn tất form đăng ký.&quot;,&quot;response_text_hint&quot;:&quot;Mình sẽ theo phần bạn đang quan tâm trước nhé. Khi cần quay lại bước đăng ký, mình vẫn có thể hỗ trợ bạn kiểm tra lại thông tin và hoàn tất form cho gọn và dễ hơn.&quot;},{&quot;response_goal&quot;:&quot;Giữ hội thoại tự nhiên, không thúc ép thao tác ngay nhưng vẫn nhắc nhẹ về bước rà soát và nộp form.&quot;,&quot;response_text_hint&quot;:&quot;Việc xem lại thông tin trước khi nộp sẽ giúp hồ sơ của bạn đầy đủ và chính xác hơn. Khi nào bạn muốn tiếp tục phần đăng ký, mình có thể đồng hành cùng bạn rà lại nhanh các bước cần thiết.&quot;},{&quot;response_goal&quot;:&quot;Soft redirect quay lại phạm vi hỗ trợ tuyển sinh và hoàn tất hồ sơ đăng ký.&quot;,&quot;response_text_hint&quot;:&quot;Mình ở đây hỗ trợ chủ yếu các nội dung liên quan đến tuyển sinh và hoàn tất đăng ký dự tuyển nha. Nếu bạn thật sự cần, mình có thể giúp bạn kiểm tra lại thông tin và bổ sung phần còn thiếu để có thể hỗ trợ tiếp bước nộp form cho bạn nhé.&quot;}]}}}</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_CB3108B8-6395-40A9-A831-857EEAC0BE48">
          <dmn:text>&quot;18&quot;</dmn:text>
