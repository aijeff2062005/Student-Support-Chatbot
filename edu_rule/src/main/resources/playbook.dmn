        <dmn:outputEntry id="_4ED16358-B1C7-4D86-B4AF-6C1682CC6C39">
          <dmn:text>&quot;Trong các ngành đang cân nhắc, {user_pronoun} đang thiên về ngành nào nhất? {self_pronoun} sẽ dựa vào đó để hỗ trợ việc đăng ký dự tuyển nhanh chóng và dễ dàng hơn.&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_BD99CF63-5D73-4FB1-8A1E-F87A6E70F873">
