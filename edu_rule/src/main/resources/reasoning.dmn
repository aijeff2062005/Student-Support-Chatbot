        </dmn:outputEntry>
        <dmn:outputEntry id="oe_default_alignment_key">
          <dmn:text>&quot;none&quot;</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="oe_default_group_by">
          <dmn:text>[&quot;none&quot;]</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="oe_default_aggregation_op">
